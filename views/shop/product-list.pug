extends ../layouts/main.pug

block content
  h1.page-title My Products
  p.page-subtitle Browse everything currently available in the shop.

  if products.length > 0
    .product-grid
      each product in products
        article.product-card
          .product-image-wrap
            img.product-image(src=product.imageUrl, alt=product.title)
          .product-body
            h2.product-title= product.title
            p.product-price $#{product.price}
            p.product-description= product.description
  else
    section.panel
      p.empty-state No products yet. Add one from the admin page.
